<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ali Sohail — Designer, Developer, AI Creator</title>
<meta name="description" content="Ali Sohail — Graphic Designer, Web Developer & AI Creator. Premium digital experiences at the intersection of design, technology and intelligence.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Inter:wght@300..700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#050505;
    --bg-2:#0a0a0a;
    --secondary:#111111;
    --card:#161616;
    --card-hover:#1c1c1c;
    --text:#ffffff;
    --text-dim:#a8a8a8;
    --text-faint:#6b6b6b;
    --accent-blue:#4f8cff;
    --accent-purple:#8b5cf6;
    --line:rgba(255,255,255,0.08);
    --line-soft:rgba(255,255,255,0.04);
    --grad: linear-gradient(120deg,var(--accent-blue),var(--accent-purple));
    --ease: cubic-bezier(.16,.84,.44,1);
  }

  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  ::selection{background:var(--accent-blue);color:#fff;}

  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter',sans-serif;
    overflow-x:hidden;
    cursor:none;
  }

  @media (max-width: 860px){
    body{cursor:auto;}
  }

  a{color:inherit;text-decoration:none;}
  img{display:block;max-width:100%;}
  button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}

  h1,h2,h3,h4{font-family:'Space Grotesk',sans-serif;font-weight:500;letter-spacing:-0.02em;}

  .wrap{max-width:1180px;margin:0 auto;padding:0 32px;}

  /* ---------- custom cursor ---------- */
  .cursor-dot, .cursor-ring{
    position:fixed;top:0;left:0;pointer-events:none;z-index:9999;
    border-radius:50%;transform:translate(-50%,-50%);
  }
  .cursor-dot{width:6px;height:6px;background:#fff;}
  .cursor-ring{
    width:34px;height:34px;border:1px solid rgba(255,255,255,0.35);
    transition:width .25s var(--ease),height .25s var(--ease),border-color .25s var(--ease),background .25s var(--ease);
  }
  .cursor-ring.hover{
    width:64px;height:64px;
    border-color:transparent;
    background:rgba(79,140,255,0.12);
    backdrop-filter:blur(2px);
  }
  @media (max-width:860px){ .cursor-dot,.cursor-ring{display:none;} }

  /* ---------- loader ---------- */
  #loader{
    position:fixed;inset:0;z-index:10000;background:#050505;
    display:flex;align-items:center;justify-content:center;flex-direction:column;gap:18px;
    transition:opacity .8s var(--ease), visibility .8s var(--ease);
  }
  #loader.done{opacity:0;visibility:hidden;}
  .loader-mark{
    font-family:'Space Grotesk',sans-serif;font-size:15px;letter-spacing:0.35em;
    color:var(--text-dim);text-transform:uppercase;
  }
  .loader-bar{width:220px;height:1px;background:var(--line);position:relative;overflow:hidden;}
  .loader-bar span{
    position:absolute;left:0;top:0;height:100%;width:0%;
    background:var(--grad);
  }

  /* ---------- ambient background ---------- */
  .glow-field{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;}
  .orb{
    position:absolute;border-radius:50%;filter:blur(90px);opacity:0.35;
    will-change:transform;
  }
  .orb-1{width:560px;height:560px;background:var(--accent-blue);top:-180px;left:-120px;}
  .orb-2{width:480px;height:480px;background:var(--accent-purple);bottom:-160px;right:-140px;opacity:0.28;}
  .mouse-glow{
    position:fixed;top:0;left:0;width:420px;height:420px;border-radius:50%;
    background:radial-gradient(circle,rgba(79,140,255,0.10),transparent 70%);
    transform:translate(-50%,-50%);pointer-events:none;z-index:1;
    transition:opacity .4s ease;
  }

  section{position:relative;z-index:2;}

  /* ---------- nav ---------- */
  header{
    position:fixed;top:0;left:0;right:0;z-index:1000;
    padding:22px 0;
    transition:background .4s var(--ease), border-color .4s var(--ease), padding .4s var(--ease);
    border-bottom:1px solid transparent;
  }
  header.scrolled{
    background:rgba(5,5,5,0.65);
    backdrop-filter:blur(16px) saturate(140%);
    -webkit-backdrop-filter:blur(16px) saturate(140%);
    border-bottom:1px solid var(--line);
    padding:16px 0;
  }
  nav{display:flex;align-items:center;justify-content:space-between;}
  .logo{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:600;}
  .logo span{color:var(--accent-blue);}
  .nav-links{display:flex;gap:36px;list-style:none;}
  .nav-links a{
    font-size:14px;color:var(--text-dim);position:relative;padding:4px 0;
    transition:color .3s ease;
  }
  .nav-links a::after{
    content:'';position:absolute;left:0;bottom:0;height:1px;width:0;
    background:var(--grad);transition:width .3s var(--ease);
  }
  .nav-links a:hover{color:var(--text);}
  .nav-links a:hover::after{width:100%;}
  .nav-cta{
    font-size:13px;padding:10px 20px;border:1px solid var(--line);border-radius:100px;
    display:inline-flex;align-items:center;gap:6px;transition:all .3s var(--ease);
  }
  .nav-cta:hover{border-color:var(--accent-blue);background:rgba(79,140,255,0.08);}
  .menu-toggle{display:none;flex-direction:column;gap:5px;background:none;border:none;z-index:1001;}
  .menu-toggle span{width:22px;height:1px;background:#fff;}

  @media (max-width:860px){
    .nav-links{
      position:fixed;top:0;right:0;height:100vh;width:78%;max-width:320px;
      background:#0a0a0a;border-left:1px solid var(--line);
      flex-direction:column;justify-content:center;align-items:flex-start;padding:0 40px;
      transform:translateX(100%);transition:transform .5s var(--ease);gap:26px;
    }
    .nav-links.open{transform:translateX(0);}
    .nav-links a{font-size:20px;}
    .menu-toggle{display:flex;}
    .nav-cta{display:none;}
  }

  /* ---------- hero ---------- */
  .hero{
    min-height:112vh;display:flex;flex-direction:column;justify-content:center;
    padding-top:120px;position:relative;
  }
  .eyebrow{
    display:flex;align-items:center;gap:10px;font-size:13px;color:var(--text-dim);
    letter-spacing:0.12em;text-transform:uppercase;margin-bottom:28px;
    opacity:0;transform:translateY(14px);
  }
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--accent-blue);box-shadow:0 0 12px var(--accent-blue);}

  .hero-title{
    font-size:clamp(58px,10.5vw,150px);line-height:0.92;font-weight:500;
    letter-spacing:-0.03em;
  }
  .hero-title .line{overflow:hidden;display:block;}
  .hero-title .line span{display:block;transform:translateY(115%);transition:transform 1s var(--ease);}
  .hero-title .line:nth-child(1) span{transition-delay:.05s;}
  .hero-title .line:nth-child(2) span{
    transition-delay:.18s;
    background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .hero.in .hero-title .line span{transform:translateY(0);}

  .hero-role{
    margin-top:26px;font-size:18px;color:var(--text-dim);display:flex;gap:14px;flex-wrap:wrap;
    opacity:0;transform:translateY(14px);
  }
  .hero-role b{color:var(--text);font-weight:500;}
  .hero-role .sep{color:var(--text-faint);}

  .hero-desc{
    margin-top:26px;max-width:460px;font-size:17px;line-height:1.6;color:var(--text-dim);
    opacity:0;transform:translateY(14px);
  }

  .hero-actions{margin-top:44px;display:flex;align-items:center;gap:24px;opacity:0;transform:translateY(14px);}

  .btn-primary{
    position:relative;display:inline-flex;align-items:center;gap:10px;
    padding:16px 30px;border-radius:100px;font-size:14px;font-weight:500;
    background:var(--text);color:#050505;overflow:hidden;
    transition:transform .4s var(--ease), box-shadow .4s var(--ease);
  }
  .btn-primary:hover{transform:scale(1.045);box-shadow:0 8px 40px rgba(79,140,255,0.35);}
  .btn-primary .arrow{transition:transform .35s var(--ease);}
  .btn-primary:hover .arrow{transform:translateX(4px);}

  .btn-ghost{font-size:14px;color:var(--text-dim);display:inline-flex;align-items:center;gap:8px;transition:color .3s;}
  .btn-ghost:hover{color:#fff;}
  .btn-ghost .ring{width:38px;height:38px;border:1px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;transition:border-color .3s;}
  .btn-ghost:hover .ring{border-color:var(--accent-blue);}

  .scroll-hint{
    position:absolute;bottom:36px;left:32px;display:flex;align-items:center;gap:12px;
    font-size:12px;color:var(--text-faint);letter-spacing:0.1em;text-transform:uppercase;
  }
  .scroll-line{width:1px;height:44px;background:var(--line);position:relative;overflow:hidden;}
  .scroll-line span{position:absolute;top:-100%;left:0;width:100%;height:100%;background:var(--grad);animation:scrollLine 2.4s ease-in-out infinite;}
  @keyframes scrollLine{ 0%{top:-100%;} 60%{top:100%;} 100%{top:100%;} }

  /* ---------- section headings ---------- */
  .section-pad{padding:160px 0;}
  .eyebrow-label{
    font-size:13px;color:var(--accent-blue);letter-spacing:0.18em;text-transform:uppercase;margin-bottom:18px;
    font-weight:500;
  }
  .section-title{font-size:clamp(32px,4.6vw,52px);font-weight:500;letter-spacing:-0.02em;line-height:1.08;}
  .section-sub{margin-top:18px;color:var(--text-dim);font-size:17px;line-height:1.7;max-width:520px;}

  .reveal{opacity:0;transform:translateY(36px);transition:opacity .9s var(--ease), transform .9s var(--ease);}
  .reveal.in{opacity:1;transform:translateY(0);}
  .reveal-stagger > *{opacity:0;transform:translateY(30px);transition:opacity .8s var(--ease), transform .8s var(--ease);}
  .reveal-stagger.in > *{opacity:1;transform:translateY(0);}
  .reveal-stagger.in > *:nth-child(1){transition-delay:.05s;}
  .reveal-stagger.in > *:nth-child(2){transition-delay:.14s;}
  .reveal-stagger.in > *:nth-child(3){transition-delay:.23s;}
  .reveal-stagger.in > *:nth-child(4){transition-delay:.32s;}

  /* ---------- about ---------- */
  .about-grid{display:grid;grid-template-columns:0.85fr 1.15fr;gap:80px;align-items:center;margin-top:70px;}
  .about-visual{
    position:relative;border-radius:20px;aspect-ratio:4/5;overflow:hidden;
    background:linear-gradient(160deg,#161616,#0a0a0a 60%);
    border:1px solid var(--line);
  }
  .about-visual::before{
    content:'';position:absolute;inset:0;
    background:radial-gradient(circle at 30% 20%, rgba(79,140,255,0.25), transparent 55%),
               radial-gradient(circle at 80% 85%, rgba(139,92,246,0.22), transparent 55%);
  }
  .about-visual .mono{
    position:absolute;bottom:24px;left:24px;font-family:'Space Grotesk',sans-serif;
    font-size:13px;color:var(--text-dim);letter-spacing:0.05em;
  }
  .about-visual .initials{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    font-family:'Space Grotesk',sans-serif;font-size:120px;font-weight:600;color:rgba(255,255,255,0.05);
  }

  .about-copy p{font-size:19px;line-height:1.7;color:var(--text-dim);}
  .about-copy p b{color:#fff;font-weight:500;}

  .stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:56px;}
  .stat{border-top:1px solid var(--line);padding-top:18px;}
  .stat-num{font-family:'Space Grotesk',sans-serif;font-size:38px;font-weight:600;
    background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .stat-label{margin-top:6px;font-size:13px;color:var(--text-dim);}

  @media (max-width:860px){
    .about-grid{grid-template-columns:1fr;gap:44px;}
    .stats-row{grid-template-columns:repeat(2,1fr);}
  }

  /* ---------- projects ---------- */
  .work-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;}
  .project-grid{margin-top:64px;display:grid;grid-template-columns:repeat(2,1fr);gap:28px;align-items:stretch;}
  .project-card{
    position:relative;border-radius:18px;overflow:hidden;border:1px solid var(--line);
    background:var(--card);transition:transform .5s var(--ease), border-color .5s var(--ease), box-shadow .5s var(--ease);
    display:flex;flex-direction:column;height:100%;
  }
  .project-card:hover{transform:translateY(-8px);border-color:rgba(79,140,255,0.4);box-shadow:0 24px 60px rgba(0,0,0,0.5);}

  /* fixed-height image container: image never overlaps text below it */
  .project-image{
    height:240px;flex-shrink:0;position:relative;overflow:hidden;
  }
  .project-image-bg{position:absolute;inset:0;transition:transform .7s var(--ease);}
  .project-card:hover .project-image-bg{transform:scale(1.06);}
  .project-image-bg.grad-a{background:linear-gradient(135deg,#1c2440,#0a0a0a 70%);}
  .project-image-bg.grad-b{background:linear-gradient(135deg,#241a3a,#0a0a0a 70%);}
  .project-image-bg.grad-c{background:linear-gradient(135deg,#12262a,#0a0a0a 70%);}
  .project-image-bg.grad-d{background:linear-gradient(135deg,#2a1a24,#0a0a0a 70%);}

  .project-logo{
    position:relative;z-index:1;height:100%;width:100%;
    display:flex;align-items:center;justify-content:center;padding:20px;
  }
  .project-logo img{
    max-width:85%;max-height:85%;object-fit:contain;
  }
  .project-tag{
    font-family:'Space Grotesk',sans-serif;font-size:15px;color:rgba(255,255,255,0.16);
    letter-spacing:0.02em;text-align:center;padding:0 20px;
  }
  .logo-badge-panel{
    background:#f7f7f7;border-radius:16px;padding:18px 26px;
    display:flex;align-items:center;justify-content:center;
    max-width:85%;max-height:85%;
    box-shadow:0 20px 50px rgba(0,0,0,0.45);
  }
  .logo-badge-panel img{max-width:100%;max-height:100%;object-fit:contain;}
  .logo-badge-panel.logo-sm{padding:14px 22px;}
  .logo-badge-panel.logo-sm img{height:105px;width:auto;max-width:100%;}

  /* content: fixed spacing below image, arrow pinned to bottom-right on every card */
  .project-body{
    display:flex;justify-content:space-between;align-items:flex-end;
    flex:1;padding:26px 26px 28px;gap:16px;
  }
  .project-text h3{font-size:21px;font-weight:500;}
  .project-text p{margin-top:6px;font-size:14px;color:var(--text-dim);}
  .project-arrow{
    width:42px;height:42px;border-radius:50%;border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
    transition:all .4s var(--ease);
  }
  .project-card:hover .project-arrow{background:var(--grad);border-color:transparent;transform:rotate(45deg);}

  @media (max-width:860px){ .project-grid{grid-template-columns:1fr;} }

/* ---------- services ---------- */
  .service-grid{margin-top:64px;display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:18px;overflow:hidden;}
  .service-card{
    background:var(--bg-2);padding:38px 28px;min-height:280px;display:flex;flex-direction:column;justify-content:space-between;
    transition:background .4s var(--ease), transform .3s var(--ease);
    transform-style:preserve-3d;will-change:transform;
  }
  .service-card:hover{background:var(--card);}
  .service-num{font-size:13px;color:var(--text-faint);font-family:'Space Grotesk',sans-serif;}
  .service-card h3{font-size:22px;margin-top:auto;padding-top:20px;}
  .service-card ul{list-style:none;margin-top:14px;font-size:14px;color:var(--text-dim);line-height:2;}
  .service-arrow{margin-top:24px;width:34px;height:34px;border-radius:50%;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;transition:all .3s ease;}
  .service-card:hover .service-arrow{border-color:var(--accent-blue);background:rgba(79,140,255,0.1);}

  @media (max-width:960px){ .service-grid{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:600px){ .service-grid{grid-template-columns:1fr;} }

  /* ---------- experience ---------- */
  .timeline{margin-top:70px;position:relative;max-width:720px;}
  .timeline-line{position:absolute;left:7px;top:0;bottom:0;width:1px;background:var(--line);}
  .timeline-line-fill{position:absolute;left:0;top:0;width:100%;height:0%;background:var(--grad);}
  .t-item{position:relative;padding-left:44px;padding-bottom:64px;}
  .t-item:last-child{padding-bottom:0;}
  .t-dot{position:absolute;left:0;top:4px;width:15px;height:15px;border-radius:50%;background:var(--bg);border:1px solid var(--line);transition:all .4s ease;}
  .t-item.in .t-dot{border-color:var(--accent-blue);box-shadow:0 0 0 5px rgba(79,140,255,0.12);}
  .t-year{font-family:'Space Grotesk',sans-serif;font-size:15px;color:var(--accent-blue);letter-spacing:0.05em;}
  .t-role{font-size:26px;margin-top:8px;font-weight:500;}
  .t-org{margin-top:6px;color:var(--text-dim);font-size:15px;}
  .t-desc{margin-top:12px;color:var(--text-dim);font-size:15px;line-height:1.7;max-width:480px;}

  /* ---------- testimonials ---------- */
  .test-wrap{margin-top:64px;position:relative;overflow:hidden;}
  .test-track{display:flex;transition:transform .7s var(--ease);}
  .test-card{
    min-width:100%;background:var(--card);border:1px solid var(--line);border-radius:20px;
    padding:56px;display:flex;flex-direction:column;gap:24px;
  }
  .stars{color:var(--accent-blue);letter-spacing:4px;font-size:16px;}
  .test-quote{font-size:24px;line-height:1.5;font-family:'Space Grotesk',sans-serif;font-weight:400;max-width:640px;}
  .test-author{display:flex;align-items:center;gap:14px;margin-top:8px;}
  .test-avatar{width:44px;height:44px;border-radius:50%;background:var(--grad);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:600;font-family:'Space Grotesk',sans-serif;}
  .test-name{font-size:15px;}
  .test-role{font-size:13px;color:var(--text-dim);}
  .test-dots{display:flex;gap:8px;margin-top:32px;}
  .test-dots button{width:8px;height:8px;border-radius:50%;background:var(--line);transition:all .3s ease;}
  .test-dots button.active{background:var(--accent-blue);width:22px;border-radius:5px;}

  /* ---------- contact ---------- */
  .contact-section{padding:180px 0;text-align:center;position:relative;}
  .contact-title{font-size:clamp(40px,7.5vw,96px);line-height:1.02;font-weight:500;}
  .contact-title .accent{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .contact-sub{margin:26px auto 0;max-width:460px;color:var(--text-dim);font-size:17px;}
  .contact-actions{margin-top:48px;display:flex;justify-content:center;}
  .social-row{margin-top:70px;display:flex;justify-content:center;gap:34px;flex-wrap:wrap;}
  .social-row a{font-size:14px;color:var(--text-dim);position:relative;padding-bottom:4px;}
  .social-row a::after{content:'';position:absolute;left:0;bottom:0;width:0;height:1px;background:var(--grad);transition:width .3s var(--ease);}
  .social-row a:hover{color:#fff;}
  .social-row a:hover::after{width:100%;}

  /* ---------- footer ---------- */
  footer{border-top:1px solid var(--line);padding:44px 0;}
  .foot-row{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;}
  .foot-left{display:flex;align-items:center;gap:14px;}
  .foot-mark{font-family:'Space Grotesk',sans-serif;font-size:18px;}
  .foot-text{font-size:13px;color:var(--text-faint);}
  .foot-year{font-size:13px;color:var(--text-faint);}

  @media (max-width:640px){
    .section-pad{padding:110px 0;}
    .wrap{padding:0 22px;}
    .about-copy p{font-size:17px;}
    .test-card{padding:34px 26px;}
    .contact-section{padding:120px 0;}
  }
</style>
</head>
<body>

<div id="loader">
  <div class="loader-mark">AS. — Loading</div>
  <div class="loader-bar"><span id="loaderFill"></span></div>
</div>

<div class="cursor-dot" id="cursorDot"></div>
<div class="cursor-ring" id="cursorRing"></div>
<div class="mouse-glow" id="mouseGlow"></div>

<div class="glow-field">
  <div class="orb orb-1" id="orb1"></div>
  <div class="orb orb-2" id="orb2"></div>
</div>

<header id="siteHeader">
  <div class="wrap">
    <nav>
      <a href="#top" class="logo">AS<span>.</span></a>
      <ul class="nav-links" id="navLinks">
        <li><a href="#work" class="nav-link">Work</a></li>
        <li><a href="#about" class="nav-link">About</a></li>
        <li><a href="#services" class="nav-link">Services</a></li>
        <li><a href="#contact" class="nav-link">Contact</a></li>
      </ul>
      <a href="#contact" class="nav-cta magnetic">Let's Talk <span>→</span></a>
      <button class="menu-toggle" id="menuToggle" aria-label="Menu"><span></span><span></span></button>
    </nav>
  </div>
</header>

<main id="top">

  <!-- HERO -->
